VEPopulationSim:
    PopSimDictionary: PopulationSim_DataDictionary.csv
    VESimHouseholdDictionary: VESimHousehold_DataDictionary.csv
    ACSYear: 2023
    PopSimOutputDir:
      2046: output_2046
    PopSimFiles:
      household_id: household_id
      households:
        filename: synthetic_households.csv
        columns:
          - NP            #Required
          - NW            #Required
          - HHINCADJ      #Required
          - HTYPE         #Required
      persons:
        filename: synthetic_persons.csv
        columns:
          - per_num        #Required
          - AGEP           #Required
          - PINCADJ        #Required
          - WORKER         #Required
    BzoneField: B_ID
